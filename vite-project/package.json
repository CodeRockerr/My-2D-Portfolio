{
  "name": "adit-shah-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/generate-resume-qr.js development",
    "dev": "vite",
    "prebuild": "node scripts/generate-resume-qr.js production",
    "build": "vite build",
    "qr:generate": "node scripts/generate-resume-qr.js production",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "format": "prettier --write src scripts tests *.js *.json *.html */index.html",
    "format:check": "prettier --check src scripts tests *.js *.json *.html */index.html"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "prettier": "^3.9.6",
    "qrcode": "^1.5.4",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
